# API key CARTO Basemaps untuk peta Supplier Terdekat (opsional).
# Minta gratis di https://carto.com/basemaps/apikey (tanpa akun, dikirim lewat email).
# Kosongkan bila tidak punya: peta otomatis memakai Esri Light Gray yang gratis tanpa key.
# Catatan: variabel VITE_ ikut terkirim ke browser, batasi domain key di dashboard CARTO.
VITE_CARTO_API_KEY=

# API key Gemini untuk Scan Struk & AI Bot (buat gratis di https://aistudio.google.com/apikey).
# Disediakan hingga 5 slot key. Sistem otomatis memutar (fallback) ke key berikutnya jika ada key yang limit/habis kuota.
# JANGAN diberi awalan VITE_ agar tidak terkirim ke browser. Di Vercel, isi juga di
# Project Settings > Environment Variables.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Opsional: ganti model default
GEMINI_MODEL=gemini-2.5-flash

