# CARTO Basemaps API key for the Nearest Suppliers map (optional).
# Request one for free at https://carto.com/basemaps/apikey (no account needed, sent by email).
# Leave empty if you don't have one: the map automatically uses the free, keyless Esri Light Gray.
# Note: VITE_ variables are shipped to the browser, so restrict the key's domains in the CARTO dashboard.
VITE_CARTO_API_KEY=

# Gemini API key for Receipt Scan & AI Bot (create one for free at https://aistudio.google.com/apikey).
# Up to 5 key slots are available. The system automatically rotates (falls back) to the next key if one hits its limit/quota.
# Do NOT prefix with VITE_ so it isn't shipped to the browser. On Vercel, also set these in
# Project Settings > Environment Variables.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Optional: change the default model
GEMINI_MODEL=gemini-2.5-flash

